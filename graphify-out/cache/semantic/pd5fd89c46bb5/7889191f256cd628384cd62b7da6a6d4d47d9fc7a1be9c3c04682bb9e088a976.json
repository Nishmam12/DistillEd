{"nodes": [{"id": "server_ai_gateway_readme_ai_gateway", "label": "InkFlow AI Gateway", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal stateless FastAPI service whose only job is routing requests to cloud-tier models. Deliberately never stores notes, memory, or user profiles; full scope decision recorded in ai_prompts/04_phase3_cloud_gateway_router.md."}, {"id": "server_ai_gateway_readme_stateless_privacy_model", "label": "Stateless Privacy Model", "file_type": "rationale", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No note, memory, or profile storage in the gateway. Keeping the service stateless means there is no user data at rest to protect, which is why the device key is explicitly not an identity."}, {"id": "server_ai_gateway_readme_device_key", "label": "X-Device-Key Header", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any client-generated UUID. Used solely as the rate-limit counter key, never as a user identity, so the gateway can throttle abuse without knowing who the caller is."}, {"id": "server_ai_gateway_readme_sse_streaming", "label": "Server-Sent Events Streaming", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default response mode emits `data: {\"text\": ...}` events; `\"stream\": false` returns a single JSON body with a request_id instead."}, {"id": "server_ai_gateway_readme_tool_calling_loop", "label": "Loop 3.4 Tool Calling", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires stream:true and a tool-capable provider (currently only the Gemma cloud tier). The gateway emits tool_call events but deliberately does NOT orchestrate the loop - the caller runs the tool and re-calls /v1/generate with a role:tool turn, keeping the service one-shot and stateless."}, {"id": "server_ai_gateway_readme_provider_fallback", "label": "Gemma Cloud Tier Fallback", "file_type": "rationale", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only OPENROUTER_API_KEY is required. Requests hinting at an unconfigured frontier provider fall back to the Gemma cloud tier automatically, so the gateway runs with zero frontier keys."}, {"id": "server_ai_gateway_readme_web_search_tool", "label": "Web Search Tool (Exa Proxy)", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /v1/tools/search proxies Exa. EXA_API_KEY is optional - without it the endpoint 503s cleanly so the Flutter app's Calculator/Wikipedia tools keep working."}, {"id": "server_ai_gateway_readme_daily_search_cap", "label": "Daily Search Cap", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DAILY_SEARCH_CAP (default 25) per device per day, tracked independently from the LLM token/request cap so search abuse cannot exhaust generation budget."}, {"id": "server_ai_gateway_readme_model_tier", "label": "Model Tier Routing", "file_type": "concept", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callers pass model_tier (e.g. cloud-mid); the gateway maps it to a concrete provider."}, {"id": "server_ai_gateway_readme_render_deployment", "label": "Render Blueprint Deployment", "file_type": "rationale", "source_file": "server/ai-gateway/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deployed on Render via repo-root render.yaml building this Dockerfile; container binds $PORT with 8000 fallback. Free plan spins down after ~15 min idle, so first request pays a cold start. Fly.io, Railway, Google Cloud Run and a small VPS were considered but not used."}], "edges": [{"source": "server_ai_gateway_readme_ai_gateway", "target": "server_ai_gateway_app_main", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ai-gateway/README.md", "source_location": null, "weight": 1.0}, {"source": "server_ai_gateway_readme_ai_gateway", "target": "server_ai_gateway_app_main_health", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ai-gateway/README.md", "source_location": null, "weight": 1.0}, {"source": "server_ai_gateway_readme_stateless_privacy_model", "target": "server_ai_gateway_readme_ai_gateway", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ai-gateway/README.md", "source_location": null, "weight": 1.0}, {"source": "server_ai_gateway_readme_device_key", "target": "server_ai_gateway_app_rate_limit_ratelimiter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ai-gateway/README.md", "source_location": null, "weight": 1.0}, {"source": "server_ai_gateway_readme_device_key", "target": "server_ai_gateway_readme_stateless_privacy_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ai-gateway/README.md", "source_location": null, "weight"