# dev_secrets.dart is intentionally NOT ignored: this repo is PRIVATE and the
# file carries a shared dev-only HuggingFace token so teammates don't each
# need their own. Read only in debug builds (see huggingFaceTokenProvider).
# If this repo is ever made public again, revert this and rotate the token
# immediately (see lib/dev/dev_secrets.dart for details).

