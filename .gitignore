# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# lib/dev/dev_secrets.dart is tracked on purpose: it holds an empty debug-only
# HuggingFace token fallback (see huggingFaceTokenProvider). Never commit a real
# token there.

# Python (server/ai-gateway/ — the Phase 3 FastAPI gateway)
__pycache__/
*.pyc
.venv/
server/ai-gateway/.env
server/ai-gateway/*.sqlite3
server/ai-gateway/.pytest_cache/
graphify-out/

# Local debugging dumps (a 51 MB logcat was once committed)
logcat_dump.txt
code_dump.txt
codebase_dump.txt
*.log

# Generated per-machine iOS files
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.*

# Android only; pub get regenerates windows/flutter/ephemeral symlinks.
/windows/
