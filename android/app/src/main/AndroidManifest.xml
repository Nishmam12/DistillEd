<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Model downloads: the on-device LLM (~2.4 GB via flutter_edge_ai /
         background_downloader) and ML Kit handwriting language models. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: without a runtime grant of this, the foreground download
         service does not activate — background_downloader bails out of
         displayNotification() before calling setForeground(), and the 2.4 GB
         model download is then killed as soon as the app is backgrounded.
         flutter_edge_ai makes the runtime request, but ONLY because
         EdgeAiInstaller passes `foreground: true`
         (features/ai/data/llm/gemma_adapter.dart) — on the plugin's size-based
         auto path nothing requests it and this declaration alone does nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Study reminders are armed again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14+: required together with the SystemForegroundService
         override below for >500 MB foreground downloads (see flutter_gemma
         1.11 README, "Foreground Service" section). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lecture recording alongside ink (Tier 4.12). Requested at runtime by
         `record` via AudioCapturePort.ensurePermission(); the feature degrades
         to "recording unavailable" if the user declines, and every other part
         of the app is unaffected. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Recording keeps running while the user writes with the screen off or
         the app backgrounded, which Android 14+ requires be declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:label="Margo"
        android:allowBackup="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Margo has no deep links. Without this Flutter takes an "Open
                 with" content:// URI for a route and shows "Page Not Found";
                 the share channel handles those intents instead. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <!-- App shortcuts: New note, Scan, Record lecture, Review cards. -->
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Share to Margo" and "Open with Margo": the same set Samsung
                 Notes registers. MainActivity copies what arrives into the
                 cache and hands it to Dart (lib/features/share/). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/x-markdown"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/x-markdown"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Android 14+ foreground downloads (>500 MB LLM model): WorkManager's
             shared service must declare the dataSync type or startForeground()
             throws. Merged with the library's entry via tools:node="merge". -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Phase 7, outside the app (Outside.kt): study reminders, the New
             note tile and the two home-screen widgets. -->
        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".NewNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_note"
            android:label="@string/tile_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name=".DueCardsWidget" android:exported="false"
            android:label="@string/widget_due_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_due_info" />
        </receiver>
        <receiver android:name=".PinnedNoteWidget" android:exported="false"
            android:label="@string/widget_pinned_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_pinned_info" />
        </receiver>

        <!-- Holds the microphone while a lecture is recorded in the background. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- GPU inference (LiteRT-LM): on Android 12+ the app linker namespace
             can't dlopen the vendor OpenCL ICD without declaring its loader.
             All optional — devices without them fall back gracefully. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ (API 30) for url_launcher: package
             visibility hides other apps' intent filters by default, so without
             this canLaunchUrl() answers false and opening the HuggingFace
             licence page silently does nothing. See
             core/utils/external_links.dart. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
