<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (Phase 7). Each opens MainActivity with a launch action. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_note" android:enabled="true"
        android:icon="@drawable/ic_outside_note" android:shortcutShortLabel="@string/shortcut_new_note">
        <intent android:action="com.margo.margo.action.NEW_NOTE"
            android:targetPackage="com.margo.margo"
            android:targetClass="com.margo.margo.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="scan" android:enabled="true"
        android:icon="@drawable/ic_outside_scan" android:shortcutShortLabel="@string/shortcut_scan">
        <intent android:action="com.margo.margo.action.SCAN"
            android:targetPackage="com.margo.margo"
            android:targetClass="com.margo.margo.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="record" android:enabled="true"
        android:icon="@drawable/ic_outside_mic" android:shortcutShortLabel="@string/shortcut_record">
        <intent android:action="com.margo.margo.action.RECORD"
            android:targetPackage="com.margo.margo"
            android:targetClass="com.margo.margo.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="review" android:enabled="true"
        android:icon="@drawable/ic_outside_cards" android:shortcutShortLabel="@string/shortcut_review">
        <intent android:action="com.margo.margo.action.REVIEW"
            android:targetPackage="com.margo.margo"
            android:targetClass="com.margo.margo.MainActivity" />
    </shortcut>
</shortcuts>
