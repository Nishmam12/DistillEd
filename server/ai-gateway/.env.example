# Copy to `.env` in this same directory (server/ai-gateway/.env — gitignored,
# never commit real keys). The gateway runs fine with only the first key set.

# Gemma cloud tier (always required) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Frontier providers — optional. Leave blank to keep that tier unavailable;
# the gateway simply falls back to the Gemma cloud tier for any request that
# hints at an unconfigured provider.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web Search tool (Loop 3.4) — optional. Leave blank to keep the tool
# unavailable (Calculator + Wikipedia still work with no key at all).
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Rate limiting (per anonymous device key, resets daily)
DAILY_TOKEN_CAP=200000
DAILY_REQUEST_CAP=500
DAILY_SEARCH_CAP=25
# Global kill switch across ALL device keys. Device keys are client-chosen, so the
# per-key caps above cannot bound spend by themselves; these do.
GLOBAL_TOKEN_CAP=2000000
GLOBAL_REQUEST_CAP=5000
GLOBAL_SEARCH_CAP=500

# Abuse bounds. IP_RATE_LIMIT_PER_MINUTE=0 turns the per-address throttle off.
# TRUSTED_PROXY_HOPS is how many proxies in front of the app append to
# X-Forwarded-For (Render: 1); get it wrong and every caller shares one address.
IP_RATE_LIMIT_PER_MINUTE=240
TRUSTED_PROXY_HOPS=1
MAX_BODY_BYTES=12582912
APPROX_COST_PER_1K_TOKENS_USD=0.001

# Where the usage counters live. On a host with a persistent disk, point this at
# it (the Docker image creates /data); otherwise caps reset on every restart.
# RATE_LIMIT_DB_PATH=/data/rate_limit.sqlite3
