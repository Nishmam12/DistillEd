# Copy to `.env` in this same directory (server/ai-gateway/.env — gitignored,
# never commit real keys). The gateway runs fine with only the first key set.

# Gemma cloud tier (always required) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Frontier providers — optional. Leave blank to keep that tier unavailable;
# the gateway simply falls back to the Gemma cloud tier for any request that
# hints at an unconfigured provider.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web Search tool (Loop 3.4) — optional. Leave blank to keep the tool
# unavailable (Calculator + Wikipedia still work with no key at all).
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Rate limiting (per anonymous device key, resets daily)
DAILY_TOKEN_CAP=200000
DAILY_REQUEST_CAP=500
DAILY_SEARCH_CAP=25
